# ========================================================
# StudyHub Environment Configuration
# ========================================================

# Server Port (Azure App Service automatically sets PORT)
PORT=5000

# MySQL Database Configuration (Local or Azure Database for MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=admin
DB_NAME=studyhub
DB_PORT=3306

# Enable SSL for Azure Database for MySQL Flexible Server (set to true on Azure)
DB_SSL=false

# ========================================================
# Microsoft Azure Blob Storage Configuration
# ========================================================
# 1. Create a Storage Account in Azure Portal
# 2. Go to "Security + networking" -> "Access keys" -> Copy Connection String
# 3. Paste the connection string below.
# When provided, all student note uploads will be saved to Azure Blob Storage!
# If left commented or empty, StudyHub gracefully uses local disk storage in /uploads.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_PRIMARY_KEY;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER_NAME=studynotes
